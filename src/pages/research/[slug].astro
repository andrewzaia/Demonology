---
import Site from '../../layouts/Site.astro';
import ArticleArt from '../../components/ArticleArt.astro';
import entries from '../../data/entries.json';
import refs from '../../data/references.json';
import entities from '../../data/entities.json';
import artwork from '../../data/artwork.json';
export function getStaticPaths(){return entries.map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
const entity=entities.find(e=>e.entryId===entry.id);
const related=entries.filter(e=>entry.related.includes(e.id));
const relatedArt=related.map(e=>({entry:e,slug:entities.find(x=>x.entryId===e.id)?.artSlug??e.slug})).filter(r=>artwork.some(a=>a.slug===r.slug)).slice(0,4);
---
<Site title={entry.title} description={entry.summary}>
<article class="wrap archive methodology"><p class="eyebrow">{entry.id} · {entity?'ENCYCLOPAEDIA':(entry.id.startsWith('TXT-')||entry.id.startsWith('HIS-'))?'HISTORICAL TEXTS':'BIBLICAL FOUNDATIONS'}</p><h1>{entry.title}</h1><p class="status">{entry.reviewStatus}</p><p class="lead">{entry.summary}</p><ArticleArt slug={entity?.artSlug??entry.slug} eager />{entity && <section class="entity-facts" aria-label="Profile summary"><h2>Profile at a glance</h2><dl><dt>Classification</dt><dd>{entity.classification}</dd><dt>Names and designations</dt><dd>{entity.names.join("; ")}</dd><dt>Key attestations</dt><dd>{entity.attestation}</dd><dt>Identity assessment</dt><dd>{entity.identity}</dd></dl><p class="status">The evidence for these classifications is discussed below.</p><a href="/encyclopaedia/">Browse the encyclopaedia</a></section>}
<nav class="article-nav" aria-label="On this page"><a href="#evidence">Evidence and interpretation</a><a href="#related">Related reading</a></nav>{(entry.id.startsWith("TXT-")||entry.id.startsWith("HIS-"))&&<p><a href="/library/">Explore the historical source library</a> · <a href="/timeline/">Historical timeline</a></p>}<h2 id="evidence">Evidence and interpretation</h2>
{entry.claims.map((claim,i)=><section class="claim" id={`claim-${i+1}`}><p class="status">{claim.evidence} · Confidence: {claim.confidence}</p><p>{claim.text}</p><ul class="citation-list">{claim.citations.map(c=><li><a href={c.url}>{c.locator}</a> · <a href={`/references/#${c.ref}`}>{refs.find(r=>r.id===c.ref)?.edition ?? c.ref}</a></li>)}</ul></section>)}
<h2 id="related">Related reading</h2>{relatedArt.length>0&&<div class="visual-grid related-visuals">{relatedArt.map(r=><article class="visual-card"><ArticleArt slug={r.slug} compact/><h3><a href={`/research/${r.entry.slug}/`}>{r.entry.title}</a></h3></article>)}</div>}<p><a href={`/atlas/?entry=${entry.id}#${entry.id}`}>Explore this study in the connection atlas</a></p><ul>{related.map(e=><li><a href={`/research/${e.slug}/`}>{e.title}</a></li>)}</ul><p><a href="/research/">Return to research archive</a></p></article>
</Site>
