---
import Site from '../../layouts/Site.astro';
import ArticleArt from '../../components/ArticleArt.astro';
import entries from '../../data/entries.json';
import entities from '../../data/entities.json';
const classifications=Array.from(new Set(entities.map(e=>e.classification))).sort();
---
<Site title="Demonic encyclopaedia" description="Biblical profiles of named spiritual beings and collective designations, with evidence and interpretative distinctions.">
<section class="wrap archive"><p class="eyebrow">THE ENCYCLOPAEDIA</p><h1>Names of the unseen realm</h1><p class="lead">Explore entities and designations from Scripture and ancient literature. All profile artwork is interpretative, not a verified physical description. A name in this catalogue does not imply an independent demon, established rank or settled identity.</p><p class="status">{entities.length} illustrated profiles in development · Editorial review pending</p><div class="archive-search" id="entity-controls" hidden><label for="entity-search">Find a profile</label><input type="search" id="entity-search" placeholder="Name, alias or passage"/><label for="entity-kind">Classification</label><select id="entity-kind"><option value="">All classifications</option>{classifications.map(c=><option value={c}>{c}</option>)}</select><button type="button" id="entity-reset" class="filter-reset">Reset filters</button><p id="entity-count" role="status"></p></div><div class="entity-grid">{entities.map(entity=>{const e=entries.find(item=>item.id===entity.entryId)!;return <article class="entity-card" data-profile data-kind={entity.classification} data-search={[e.title,e.summary,entity.attestation,entity.identity,...entity.names].join(" ").toLowerCase()}><ArticleArt slug={entity.artSlug??e.slug} compact /><div class="entity-card-copy"><p class="status">{e.id} · {entity.classification}</p><h2><a href={`/research/${e.slug}/`}>{e.title}</a></h2><p>{e.summary}</p><p class="citation">{entity.attestation}</p><p class="status">{entity.identity}</p><a href={`/research/${e.slug}/`}>Read profile &rarr;</a></div></article>;})}</div><p id="entity-empty" hidden>No matching entity profiles.</p><p><a href="/research/">Explore all research</a> · <a href="/methodology/">Evidence methodology</a></p></section>
<script>
const box=document.querySelector<HTMLElement>('#entity-controls'),search=document.querySelector<HTMLInputElement>('#entity-search'),kind=document.querySelector<HTMLSelectElement>('#entity-kind'),count=document.querySelector<HTMLElement>('#entity-count'),empty=document.querySelector<HTMLElement>('#entity-empty'),reset=document.querySelector<HTMLButtonElement>('#entity-reset');const cards=Array.from(document.querySelectorAll<HTMLElement>('[data-profile]'));
if(box&&search&&kind&&count&&empty&&reset){box.hidden=false;const update=()=>{const terms=search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);for(const card of cards)card.hidden=(!!kind.value&&card.dataset.kind!==kind.value)||!terms.every(t=>(card.dataset.search??'').includes(t));const n=cards.filter(c=>!c.hidden).length;count.textContent=n+' of '+cards.length+' profiles';empty.hidden=n!==0;};search.addEventListener('input',update);kind.addEventListener('change',update);reset.addEventListener('click',()=>{search.value='';kind.value='';update();search.focus();});update();}
</script></Site>
