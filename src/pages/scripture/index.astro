---
import Site from '../../layouts/Site.astro';
import entries from '../../data/entries.json';
import refs from '../../data/references.json';
const scriptureRefs=new Set(refs.filter(r=>r.type==='Scripture').map(r=>r.id));
const passages=Array.from(new Map(entries.flatMap(e=>e.claims.flatMap(c=>c.citations)).filter(c=>scriptureRefs.has(c.ref)).map(c=>[c.locator,c])).values()).sort((a,b)=>a.locator.localeCompare(b.locator));
---
<Site title="Scripture index" description="Biblical passages cited by the Demonology archive.">
<section class="wrap archive methodology"><p class="eyebrow">SCRIPTURE INDEX</p><h1>Biblical passages</h1><p>Browse passages actually cited in the archive. This is a developing index, not a claim of comprehensive coverage.</p>
{passages.map(p=><section class="claim"><h2><a href={p.url}>{p.locator}</a></h2><ul>{entries.filter(e=>e.claims.some(c=>c.citations.some(s=>s.locator===p.locator&&scriptureRefs.has(s.ref)))).map(e=><li><a href={`/research/${e.slug}/`}>{e.title}</a></li>)}</ul></section>)}
</section></Site>
