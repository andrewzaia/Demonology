---
import Site from '../../layouts/Site.astro';
import entries from '../../data/entries.json';
import refs from '../../data/references.json';
const books=["Genesis","Exodus","Leviticus","Numbers","Deuteronomy","Joshua","Judges","Ruth","1 Samuel","2 Samuel","1 Kings","2 Kings","1 Chronicles","2 Chronicles","Ezra","Nehemiah","Esther","Job","Psalms","Proverbs","Ecclesiastes","Song of Solomon","Isaiah","Jeremiah","Lamentations","Ezekiel","Daniel","Hosea","Joel","Amos","Obadiah","Jonah","Micah","Nahum","Habakkuk","Zephaniah","Haggai","Zechariah","Malachi","Matthew","Mark","Luke","John","Acts","Romans","1 Corinthians","2 Corinthians","Galatians","Ephesians","Philippians","Colossians","1 Thessalonians","2 Thessalonians","1 Timothy","2 Timothy","Titus","Philemon","Hebrews","James","1 Peter","2 Peter","1 John","2 John","3 John","Jude","Revelation"];
const bookOf=(locator:string)=>books.find(b=>locator.startsWith(b+' '))??'Other cited passages';
const scriptureRefs=new Set(refs.filter(r=>r.type==='Scripture').map(r=>r.id));
const cites=entries.flatMap(e=>e.claims.flatMap(c=>c.citations)).filter(c=>scriptureRefs.has(c.ref));
const passages=Array.from(new Set(cites.map(c=>c.locator))).sort((a,b)=>a.localeCompare(b,undefined,{numeric:true}));
const sections=[...books,'Other cited passages'].map(book=>({book,passages:passages.filter(p=>bookOf(p)===book)})).filter(g=>g.passages.length);
---
<Site title="Scripture index" description="Biblical passages cited by the Demonology archive.">
<section class="wrap archive methodology"><p class="eyebrow">SCRIPTURE INDEX</p><h1>Biblical passages</h1><p>Browse passages actually cited in the archive, arranged in Biblical book order. Translation comparisons retain their own links. This is a developing index, not a claim of comprehensive coverage.</p><p class="status">{passages.length} cited passage references across {sections.length} book groups</p>
<div class="archive-search" id="scripture-controls" hidden><label for="scripture-search">Find a passage or study</label><input id="scripture-search" type="search" placeholder="Search a reference or related study"/><label for="scripture-book">Biblical book</label><select id="scripture-book"><option value="">All books</option>{sections.map(g=><option value={g.book}>{g.book}</option>)}</select><button type="button" class="filter-reset" id="scripture-reset">Reset filters</button><p id="scripture-count" role="status"></p></div>
<nav class="scripture-jump" aria-label="Books represented in the index">{sections.map(g=><a href={`#book-${g.book.toLowerCase().replace(/ /g,'-')}`}>{g.book}</a>)}</nav>
{sections.map(g=><section class="scripture-book-group" data-book-group={g.book} id={`book-${g.book.toLowerCase().replace(/ /g,'-')}`}><h2>{g.book}</h2>{g.passages.map(locator=>{const related=entries.filter(e=>e.claims.some(c=>c.citations.some(s=>s.locator===locator&&scriptureRefs.has(s.ref))));return <section class="claim" data-passage data-book={g.book} data-search={[locator,...related.map(e=>e.title)].join(' ').toLowerCase()}><h3>{locator}</h3><p class="citation">{Array.from(new Map(cites.filter(c=>c.locator===locator).map(c=>[c.ref,c])).values()).map(c=><a class="translation-link" href={c.url}>{refs.find(r=>r.id===c.ref)?.edition??c.ref}</a>)}</p><ul>{related.map(e=><li><a href={`/research/${e.slug}/`}>{e.title}</a></li>)}</ul></section>})}</section>)}
<p id="scripture-empty" hidden>No matching passages. Try a different reference or reset the filters.</p></section></Site>
<script>
const controls=document.querySelector<HTMLElement>('#scripture-controls'),search=document.querySelector<HTMLInputElement>('#scripture-search'),book=document.querySelector<HTMLSelectElement>('#scripture-book'),count=document.querySelector<HTMLElement>('#scripture-count'),empty=document.querySelector<HTMLElement>('#scripture-empty'),reset=document.querySelector<HTMLButtonElement>('#scripture-reset');
const rows=Array.from(document.querySelectorAll<HTMLElement>('[data-passage]'));
if(controls&&search&&book&&count&&empty&&reset){controls.hidden=false;const update=()=>{const terms=search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);for(const r of rows)r.hidden=(!!book.value&&r.dataset.book!==book.value)||!terms.every(t=>(r.dataset.search??'').includes(t));for(const g of document.querySelectorAll<HTMLElement>('[data-book-group]'))g.hidden=!g.querySelector('[data-passage]:not([hidden])');const n=rows.filter(r=>!r.hidden).length;count.textContent=n+' of '+rows.length+' references';empty.hidden=n!==0;};search.addEventListener('input',update);book.addEventListener('change',update);reset.addEventListener('click',()=>{search.value='';book.value='';update();search.focus();});for(const a of document.querySelectorAll<HTMLAnchorElement>('.scripture-jump a'))a.addEventListener('click',()=>{search.value='';book.value='';update();});update();}
</script>
