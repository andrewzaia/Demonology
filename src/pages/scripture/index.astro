---
import Site from '../../layouts/Site.astro';
import entries from '../../data/entries.json';
import refs from '../../data/references.json';
const scriptureRefs=new Set(refs.filter(r=>r.type==='Scripture').map(r=>r.id));
const cites=entries.flatMap(e=>e.claims.flatMap(c=>c.citations)).filter(c=>scriptureRefs.has(c.ref));
const passages=Array.from(new Set(cites.map(c=>c.locator))).sort((a,b)=>a.localeCompare(b,undefined,{numeric:true}));
---
<Site title="Scripture index" description="Biblical passages cited by the Demonology archive.">
<section class="wrap archive methodology"><p class="eyebrow">SCRIPTURE INDEX</p><h1>Biblical passages</h1><p>Browse passages actually cited in the archive. Translation comparisons retain their own links. This is a developing index, not a claim of comprehensive coverage.</p>
{passages.map(locator=><section class="claim"><h2>{locator}</h2><p class="citation">{Array.from(new Map(cites.filter(c=>c.locator===locator).map(c=>[c.ref,c])).values()).map(c=><a class="translation-link" href={c.url}>{refs.find(r=>r.id===c.ref)?.edition??c.ref}</a>)}</p><ul>{entries.filter(e=>e.claims.some(c=>c.citations.some(s=>s.locator===locator&&scriptureRefs.has(s.ref)))).map(e=><li><a href={`/research/${e.slug}/`}>{e.title}</a></li>)}</ul></section>)}
</section></Site>
