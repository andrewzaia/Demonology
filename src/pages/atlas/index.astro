---
import Site from '../../layouts/Site.astro';
import entries from '../../data/entries.json';
import refs from '../../data/references.json';
const citationKey=(c:{ref:string;locator:string})=>c.ref+'|'+c.locator;
const connections=entries.map(entry=>{
 const unique=new Map(entry.claims.flatMap(c=>c.citations).map(c=>[citationKey(c),c]));
 const related=entry.related.map(id=>entries.find(e=>e.id===id)!).filter(Boolean).map((target,i,all)=>{
 const keys=new Set(target.claims.flatMap(c=>c.citations.map(citationKey)));
 const shared=Array.from(unique.values()).filter(c=>keys.has(citationKey(c)));
 const theta=-Math.PI/2+2*Math.PI*i/all.length;
 return {target,shared,x:320+235*Math.cos(theta),y:190+140*Math.sin(theta)};
 });
 return {entry,related};
});
---
<Site title="Connection atlas" description="Explore linked studies and shared sources, without assuming a hierarchy of spiritual beings.">
<section class="wrap archive"><p class="eyebrow">THE CONNECTION ATLAS</p><h1>Follow the connections</h1><p class="lead">Explore how research entries relate through cited passages and editorial cross-references.</p><p>Connections describe research relationships, not a supernatural hierarchy. A shared citation is not proof that two identities are the same.</p>
<div class="atlas-controls" hidden><label for="atlas-entry">Choose a study</label><select id="atlas-entry">{connections.map(({entry})=><option value={entry.id} selected={entry.id==='DOC-0002'}>{entry.title}</option>)}</select><p id="atlas-status" role="status"></p></div>
<div class="atlas-legend"><span><i class="atlas-line"></i> Shared exact citation in the same edition</span><span><i class="atlas-line editorial"></i> Related reading without an exact shared citation</span></div>
{connections.map(({entry,related})=><section class="atlas-panel" data-atlas={entry.id} id={entry.id}><h2>{entry.title}</h2><p><a href={`/research/${entry.slug}/`}>Read this study</a> · {related.length} related entries</p>
<svg class="atlas-graph" viewBox="0 0 640 380" aria-hidden="true" focusable="false">
{related.map(r=><line x1="320" y1="190" x2={r.x} y2={r.y} class:list={['atlas-edge',{'editorial':!r.shared.length}]}/>)}
<circle cx="320" cy="190" r="41" class="atlas-centre"/><text x="320" y="194" text-anchor="middle" class="atlas-label">{entry.id}</text>
{related.map(r=><g><circle cx={r.x} cy={r.y} r="34" class="atlas-node"/><text x={r.x} y={r.y+4} text-anchor="middle" class="atlas-label">{r.target.id}</text></g>)}
</svg>
<div class="atlas-links">{related.map(r=><article class="claim"><p class="status">{r.target.id} · {r.shared.length?'Shared citation':'Editorial cross-reference'}</p><h3><a href={`/research/${r.target.slug}/`}>{r.target.title}</a></h3>{r.shared.length>0&&<ul>{r.shared.map(c=><li><a href={c.url}>{c.locator}</a> · {refs.find(s=>s.id===c.ref)?.edition}</li>)}</ul>}<a href={`/atlas/?entry=${r.target.id}#${r.target.id}`} data-atlas-focus={r.target.id}>Explore connections for {r.target.id}</a></article>)}</div></section>)}
</section>
<script>
const controls=document.querySelector<HTMLElement>('.atlas-controls');
const select=document.querySelector<HTMLSelectElement>('#atlas-entry');
const status=document.querySelector<HTMLElement>('#atlas-status');
const panels=Array.from(document.querySelectorAll<HTMLElement>('[data-atlas]'));
if(controls&&select&&status){controls.hidden=false;const update=(id:string)=>{if(!panels.some(p=>p.dataset.atlas===id))id='DOC-0002';select.value=id;for(const p of panels)p.hidden=p.dataset.atlas!==id;status.textContent='Showing '+(select.selectedOptions[0]?.textContent??id);};const params=new URLSearchParams(location.search);update(params.get('entry')??location.hash.slice(1)??'DOC-0002');select.addEventListener('change',()=>{update(select.value);history.replaceState(null,'','?entry='+encodeURIComponent(select.value));});for(const link of document.querySelectorAll<HTMLAnchorElement>('[data-atlas-focus]'))link.addEventListener('click',e=>{if(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;e.preventDefault();const id=link.dataset.atlasFocus??'';update(id);history.replaceState(null,'','?entry='+encodeURIComponent(id));select.focus();});}
</script>
</Site>
