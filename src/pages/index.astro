---
import Site from '../layouts/Site.astro';
import ArticleArt from '../components/ArticleArt.astro';
import entries from '../data/entries.json';
import refs from '../data/references.json';
const scriptureRefs=new Set(refs.filter(r=>r.type==='Scripture').map(r=>r.id));
import collections from '../data/collections.json';
import artwork from '../data/artwork.json';
const visualStudies=['authority-of-christ','temptation-of-christ','angelic-rebellion','nephilim'].map(slug=>artwork.find(a=>a.slug===slug)!);
const featured=entries.find(e=>e.id==='DOC-0002')!;
const passages=new Set(entries.flatMap(e=>e.claims.flatMap(c=>c.citations.filter(s=>scriptureRefs.has(s.ref)).map(s=>s.locator)))).size;
---
<Site title="A Biblical Study of the Unseen Realm" description="Explore Biblical demonology, spiritual warfare, fallen angels and historical Christian research.">
<section class="hero library-hero"><img class="hero-art" src="/media/authority-of-christ.webp" width="1279" height="720" alt="" fetchpriority="high" decoding="async"/><div class="hero-shade" aria-hidden="true"></div><div class="wrap hero-content">
<p class="eyebrow">A BIBLICAL STUDY OF THE UNSEEN REALM</p><h1>Exploring the darkness<br/><em>through the light of Scripture.</em></h1>
<p class="hero-copy">What does Scripture actually reveal about spiritual evil? Discover the Biblical accounts, the questions they raise, and the authority of Jesus Christ over the unseen realm.</p>
<div class="actions"><a class="primary" href="/research/">Enter the archive</a><a class="secondary" href="/media/">Explore the gallery</a></div><p class="hero-credit">AI-generated illustration inspired by Mark 1:21-28</p></div></section>
<section class="wrap scripture" id="scripture"><p class="eyebrow">A PASSAGE TO REFLECT ON</p><blockquote>For we wrestle not against flesh and blood, but against principalities, against powers, against the rulers of the darkness of this world, against spiritual wickedness in high places.</blockquote><p class="citation"><a href="https://www.biblegateway.com/passage/?search=Ephesians+6%3A12&version=KJV">Ephesians 6:12</a> · KJV</p></section>
<section class="wrap archive" id="archive"><div class="section-heading"><div><p class="eyebrow">THE READING ROOM</p><h2>Where to begin</h2></div><a href="/research/">Browse all studies</a></div>
<article class="featured-study illustrated-feature"><ArticleArt slug={featured.slug} compact /><div><p class="eyebrow">FOUNDATIONAL READING</p><h3><a href={`/research/${featured.slug}/`}>{featured.title}</a></h3><p>{featured.summary}</p><p class="status">{featured.reviewStatus}</p></div><a class="reading-link" href={`/research/${featured.slug}/`}>Read the study &rarr;</a></article>
<section class="visual-discovery" aria-label="Illustrated studies"><div class="section-heading"><h2>Explore through art</h2><a href="/media/">All illustrations</a></div><div class="visual-grid">{visualStudies.map(a=>{const e=entries.find(x=>x.id===a.entryId)!;return <article class="visual-card"><ArticleArt slug={a.slug} compact/><h3><a href={`/research/${e.slug}/`}>{e.title}</a></h3></article>;})}</div></section><div class="collection-grid">{collections.map(g=><section class="collection"><h3>{g.title==="Demonic encyclopaedia"?<a href="/encyclopaedia/">{g.title}</a>:g.title}</h3><ArticleArt slug={g.title==="The unseen realm"?"principalities-and-powers":g.title==="Ancient questions"?"nephilim":g.title==="Begin with Scripture"?"spiritual-warfare":g.title==="Demonic encyclopaedia"?"abaddon-apollyon":g.title==="Ancient literature"?"book-of-enoch":g.title==="Apocalyptic studies"?"final-judgement-of-evil":"satan-in-scripture"} compact /><p>{g.description}</p><ul>{entries.filter(e=>g.ids.includes(e.id)).map(e=><li><a href={`/research/${e.slug}/`}>{e.title}</a></li>)}</ul></section>)}</div></section>
<section class="wrap archive discovery"><p class="eyebrow">EXPLORE FURTHER</p><h2>Follow the evidence</h2><div class="collection-grid"><section class="collection"><h3><a href="/scripture/">Scripture index</a></h3><p>{passages} cited passage references across the collection.</p></section><section class="collection"><h3><a href="/library/">Historical source library</a></h3><p>Explore ancient manuscripts and original Christian writings.</p></section><section class="collection"><h3><a href="/timeline/">Historical timeline</a></h3><p>Follow dated textual witnesses through the centuries.</p></section><section class="collection"><h3><a href="/references/">Reference library</a></h3><p>Trace each study back to the sources that support it.</p></section><section class="collection"><h3><a href="/methodology/">How we study</a></h3><p>Understand evidence, interpretation and the limits of certainty.</p></section><section class="collection"><h3><a href="/atlas/">Connection atlas</a></h3><p>Discover connections between research entries and the sources they share.</p></section><section class="collection"><h3><a href="/media/">Illustration gallery</a></h3><p>Explore the original artwork and the Biblical studies that inspired it.</p></section><section class="collection"><h3><a href="/about/">The next chapters</a></h3><p>{entries.length} studies in development, with individual entity profiles and further ancient literature planned.</p></section></div></section>
</Site>
