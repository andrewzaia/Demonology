---
import Site from '../../layouts/Site.astro';
import entries from '../../data/entries.json';
import refs from '../../data/references.json';
import terms from '../../data/terminology.json';
---
<Site title="Reference library" description="Source register and citations for the Demonology archive.">
<section class="wrap archive methodology"><p class="eyebrow">SOURCE LIBRARY</p><h1>References</h1><p class="lead">Sources are registered independently of research entries. Individual claims link to precise passages.</p><p><a href="/library/">Browse manuscripts and texts</a> · <a href="/timeline/">Historical timeline</a></p>
{refs.map(r=><section class="claim" id={r.id}><p class="status">{r.id} · {r.type}</p><h2>{r.title}</h2><p>{r.edition}</p><p>{r.rightsNote}</p>{'url' in r && typeof r.url==='string' && <p><a href={r.url}>Read original source or edition</a></p>}<h3>Citing entries</h3><ul>{entries.filter(e=>e.claims.some(c=>c.citations.some(s=>s.ref===r.id))||terms.some(t=>t.entryId===e.id&&t.ref===r.id)).map(e=><li><a href={`/research/${e.slug}/`}>{e.title}</a></li>)}</ul></section>)}
</section></Site>
